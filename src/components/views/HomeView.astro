---
import BookingButton from '../BookingButton.astro';
import CampaignCard from '../CampaignCard.astro';
import Hero from '../Hero.astro';
import OpeningHours from '../OpeningHours.astro';
import PageHeading from '../PageHeading.astro';
import Section from '../Section.astro';
import TreatmentCard from '../TreatmentCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCampaigns, getServices, entrySlug } from '../../lib/content.ts';
import { isCampaignActive } from '../../lib/campaigns.ts';
import { localisePath, useTranslations, type Locale } from '../../i18n/index.ts';
import { SALON } from '../../lib/site.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const services = await getServices(locale);
const featured = services.filter((service) => service.data.featured).slice(0, 6);

const campaigns = (await getCampaigns(locale)).filter((campaign) => isCampaignActive(campaign.data, new Date()));

const copy = {
  sv: {
    description: 'Hudvård, CO2-laser, fransar och bryn, massage och head spa i Nääs Fabriker utanför Floda.',
    lead: 'Skönhet och hälsa i lugn takt, i gamla spinneriet vid Nääs Fabriker. Varje behandling anpassas efter dig och din hud.',
    heroAlt: 'Hudterapeut som utför en head spa-behandling i Studio Taubes salong',
    featuredTitle: 'Populära behandlingar',
    campaignsTitle: 'Aktuella erbjudanden',
    visitTitle: 'Välkommen till oss',
    visitLead: 'Du hittar oss i Nääs Fabriker i Tollered, mellan Floda och Alingsås.',
  },
  en: {
    description: 'Skincare, CO2 laser, lashes and brows, massage and head spa at Nääs Fabriker, outside Floda.',
    lead: 'Beauty and wellness at an unhurried pace, in the old spinning mill at Nääs Fabriker. Every treatment is adapted to you and your skin.',
    heroAlt: 'A skin therapist performing a head spa treatment in the Studio Taube salon',
    featuredTitle: 'Popular treatments',
    campaignsTitle: 'Current offers',
    visitTitle: 'Come and see us',
    visitLead: 'You will find us at Nääs Fabriker in Tollered, between Floda and Alingsås.',
  },
}[locale];
---

<BaseLayout locale={locale} title={SALON.tagline} description={copy.description}>
  <Hero locale={locale} lead={copy.lead} imageAlt={copy.heroAlt} />

  {
    campaigns.length > 0 && (
      <Section tone="shell">
        <h2 class="text-ink font-serif text-3xl">{copy.campaignsTitle}</h2>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {campaigns.map((campaign) => (
            <CampaignCard
              locale={locale}
              slug={entrySlug(campaign.id)}
              title={campaign.data.title}
              summary={campaign.data.summary}
              priceSek={campaign.data.priceSek}
              ordinaryPriceSek={campaign.data.ordinaryPriceSek}
              durationMinutes={campaign.data.durationMinutes}
              requiresConsultation={campaign.data.requiresConsultation}
              bokadirektServiceId={campaign.data.bokadirektServiceId}
              bokadirektSlug={campaign.data.bokadirektSlug}
            />
          ))}
        </div>
      </Section>
    )
  }

  <Section>
    <h2 class="text-ink font-serif text-3xl">{copy.featuredTitle}</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        featured.map((service) => (
          <TreatmentCard
            locale={locale}
            slug={entrySlug(service.id)}
            category={service.data.category}
            title={service.data.title}
            summary={service.data.summary}
            durationMinutes={service.data.durationMinutes}
            priceSek={service.data.priceSek}
            priceFrom={service.data.priceFrom}
            isFree={service.data.isFree}
            requiresConsultation={service.data.requiresConsultation}
            bokadirektServiceId={service.data.bokadirektServiceId}
          />
        ))
      }
    </div>
    <p class="mt-10">
      <a class="text-sand-ink hover:text-ink wordmark-label text-xs" href={localisePath('/behandlingar/', locale)}>
        {t('treatments.allCategories')} →
      </a>
    </p>
  </Section>

  <Section tone="shell">
    <div class="grid gap-10 lg:grid-cols-2">
      <div>
        <PageHeading title={copy.visitTitle} lead={copy.visitLead} />
        <address class="text-ink-muted mt-6 not-italic">
          {SALON.street}<br />{SALON.postalCode}
          {SALON.city}
        </address>
        <BookingButton locale={locale} class="mt-8" />
      </div>
      <OpeningHours locale={locale} />
    </div>
  </Section>
</BaseLayout>
