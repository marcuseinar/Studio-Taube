{
  "name": "studiotaube",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run check && npm run test && npm run build && npm run check:links && npm run check:schema && npm run check:i18n && npm run check:catalogue",
    "check:links": "node scripts/check-links.mjs dist",
    "check:schema": "node scripts/check-structured-data.mjs dist",
    "check:i18n": "node scripts/check-translations.mjs",
    "check:catalogue": "node scripts/check-catalogue-freshness.mjs",
    "sync:catalogue": "node scripts/sync-bokadirekt-catalogue.mjs",
    "build:video": "node scripts/build-hero-video.mjs",
    "check:drift": "node scripts/check-catalogue-drift.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "^7.2.5",
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^5.18.2",
    "svelte": "^5.56.10",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "astro-eslint-parser": "^3.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-astro": "^1.7.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
