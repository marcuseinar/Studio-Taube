---
import { cn } from '../lib/cn.ts';

interface Props {
  tone?: 'cream' | 'shell' | 'blush';
  class?: string;
  [attribute: string]: unknown;
}

const { tone = 'cream', class: className = '', ...attributes } = Astro.props;

const tones = { cream: 'bg-cream', shell: 'bg-shell', blush: 'bg-blush' } as const;
---

<section class={cn(tones[tone], className)} {...attributes}>
  <div class="mx-auto max-w-[1200px] px-5 py-16 sm:py-20">
    <slot />
  </div>
</section>
