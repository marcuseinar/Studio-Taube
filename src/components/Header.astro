---
import BookingButton from './BookingButton.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import NavList from './NavList.astro';
import Wordmark from './Wordmark.astro';
import { localisePath, useTranslations, type Locale } from '../i18n/index.ts';
import { SALON } from '../lib/site.ts';

interface Props {
  locale: Locale;
  pathname: string;
}

const { locale, pathname } = Astro.props;
const t = useTranslations(locale);
const home = localisePath('/', locale);
---

<header class="border-sand/40 bg-cream/95 sticky top-0 z-50 border-b backdrop-blur">
  <div class="mx-auto flex max-w-[1200px] items-center gap-2 px-4 py-3 sm:gap-6 sm:px-5 sm:py-4">
    <a href={home} class="text-ink shrink-0" aria-label={`${SALON.name} — ${t('nav.home')}`}>
      <Wordmark class="w-[132px] sm:w-[170px] lg:w-[190px]" label={`${SALON.name} ${SALON.tagline}`} />
    </a>

    <nav aria-label={t('nav.menu')} class="hidden lg:block">
      <NavList locale={locale} pathname={pathname} class="flex items-center gap-x-5 xl:gap-x-6" />
    </nav>

    <div class="ml-auto flex items-center gap-2 sm:gap-4">
      <LanguageSwitch locale={locale} pathname={pathname} />
      <BookingButton locale={locale} class="hidden px-5 sm:inline-flex" />

      <!--
        A native disclosure keeps the mobile menu working with zero JavaScript.
        Hidden from the accessibility tree on large screens, where the nav above
        is visible instead, so the two never present as duplicate navigation.
      -->
      <details class="relative lg:hidden">
        <summary
          class="wordmark-label text-ink-muted hover:text-sand-ink flex min-h-11 cursor-pointer list-none items-center gap-2 text-[0.7rem] [&::-webkit-details-marker]:hidden"
        >
          {t('nav.menu')}
          <svg
            viewBox="0 0 16 16"
            class="h-3 w-3"
            aria-hidden="true"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path d="M2 4h12M2 8h12M2 12h12" stroke-linecap="round"></path>
          </svg>
        </summary>

        <nav
          aria-label={t('nav.menu')}
          class="border-sand/40 bg-cream rounded-card absolute right-0 z-50 mt-3 w-56 border p-4 shadow-lg"
        >
          <NavList locale={locale} pathname={pathname} class="flex flex-col" />
          <BookingButton locale={locale} class="mt-3 w-full sm:hidden" />
        </nav>
      </details>
    </div>
  </div>
</header>
