---
import wordmark from '../assets/logo-wordmark-inline.svg?raw';
import { cn } from '../lib/cn.ts';

interface Props {
  class?: string;
  label: string;
}

const { class: className = '', label } = Astro.props;
---

<span class={cn('inline-block', className)} role="img" aria-label={label} set:html={wordmark} />
