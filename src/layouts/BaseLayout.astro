---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SeoHead from '../components/SeoHead.astro';
import { HTML_LANG, useTranslations, type Locale } from '../i18n/index.ts';

interface Props {
  locale: Locale;
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
const t = useTranslations(locale);
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <SeoHead locale={locale} title={title} description={description} pathname={pathname} />
  </head>
  <body>
    <a
      href="#main"
      class="bg-sand-ink text-cream focus:rounded-pill sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:px-5 focus:py-3"
    >
      {t('nav.skipToContent')}
    </a>

    <Header locale={locale} pathname={pathname} />

    <main id="main">
      <slot />
    </main>

    <Footer locale={locale} />
  </body>
</html>
