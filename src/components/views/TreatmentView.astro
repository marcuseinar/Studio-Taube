---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BookingButton from '../BookingButton.astro';
import PageHeading from '../PageHeading.astro';
import Section from '../Section.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { entrySlug } from '../../lib/content.ts';
import { categoryLabel } from '../../i18n/categories.ts';
import { formatDuration, formatPriceRange } from '../../lib/format.ts';
import { localisePath, useTranslations, type Locale } from '../../i18n/index.ts';

interface Props {
  locale: Locale;
  service: CollectionEntry<'services'>;
}

const { locale, service } = Astro.props;
const t = useTranslations(locale);
const { Content } = await render(service);

const slug = entrySlug(service.id);
const { data } = service;
const price = data.isFree
  ? locale === 'sv'
    ? 'Kostnadsfri'
    : 'Free'
  : formatPriceRange(data.priceSek, data.priceFrom, locale);
---

<BaseLayout locale={locale} title={data.title} description={data.summary}>
  <Section>
    <PageHeading eyebrow={categoryLabel(data.category, locale)} title={data.title} lead={data.summary} />

    <dl class="border-sand/40 mt-10 flex flex-wrap gap-x-12 gap-y-4 border-y py-6">
      <div>
        <dt class="wordmark-label text-ink-muted text-[0.65rem]">{t('treatments.duration')}</dt>
        <dd class="tabular text-ink mt-1 text-lg">{formatDuration(data.durationMinutes, locale)}</dd>
      </div>
      <div>
        <dt class="wordmark-label text-ink-muted text-[0.65rem]">{t('treatments.price')}</dt>
        <dd class="tabular text-ink mt-1 text-lg">{price}</dd>
      </div>
    </dl>

    {
      data.requiresConsultation && (
        <p class="bg-blush/50 text-ink rounded-card mt-8 max-w-[68ch] p-4 text-sm">
          {t('booking.consultationRequired')}
        </p>
      )
    }

    <div class="prose-taube text-ink-muted mt-8 max-w-[68ch]">
      <Content />
    </div>

    <div class="mt-10 flex flex-wrap gap-4">
      <BookingButton
        locale={locale}
        service={{ slug, bokadirektServiceId: data.bokadirektServiceId }}
        label={t('booking.cta.service')}
      />
      <a
        href={localisePath('/behandlingar/', locale)}
        class="border-sand-deep text-sand-ink hover:bg-shell wordmark-label rounded-pill inline-flex min-h-11 items-center border px-7 py-3 text-sm"
      >
        {t('treatments.allCategories')}
      </a>
    </div>
  </Section>
</BaseLayout>
